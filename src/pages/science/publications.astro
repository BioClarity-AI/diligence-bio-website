---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';

/**
 * The one page on the site with no stage: a full-width list rather than a
 * copy/canvas split, because the content itself — the citations — is the
 * argument. Shares IndexPage's locked-viewport shell rather than PageShell's
 * split, and DetailPage's breadcrumb styling rather than its wide single-claim
 * body.
 */
interface Publication {
  year: string;
  authors: string;
  title: string;
  /** Italicised venue name, e.g. "Nature Communications, 14". */
  venue: string;
  /** Plain text following the italic venue, e.g. "(1), 1989." */
  detail: string;
  tag: string;
  /** Preprints get a neutral outline; named venues get a filled accent tag. */
  tagVariant: 'preprint' | 'venue';
  href: string;
  linkLabel: string;
}

