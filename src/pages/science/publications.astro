const title = 'Publications — DiligenceBio';
const description =
  'Peer-reviewed work and preprints from our team on generalizability, negative sampling, and measurement in biological machine learning.';
---

<Base title={title} description={description}>
  <div class="shell">
    <SiteNav />
    <main class="body">
      <div class="intro">
        <p class="crumb">
          <span class="pulse" aria-hidden="true"></span>
          <a href="/science">Our science</a>
          <span class="slash" aria-hidden="true">/</span>
          <span class="index">03</span>
        </p>

        <h1>Publications</h1>
        <p class="lede">
          Peer-reviewed work and preprints from our team on generalizability, negative sampling, and measurement in
          biological machine learning.
        </p>
      </div>

      <ul class="pub-list">
        {
          publications.map((pub) => (
            <li class="pub">
              <div class="pub-year">{pub.year}</div>
              <div class="pub-body">
                <p class="pub-citation">
                  {pub.authors} {pub.title} <em>{pub.venue}</em>
                  {pub.detail}
                </p>
                <div class="pub-meta">
                  <span class:list={['tag', pub.tagVariant]}>{pub.tag}</span>
                  <a href={pub.href} target="_blank" rel="noopener">
                    {pub.linkLabel}
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</Base>

<style>
  .shell {
    height: 100dvh;
    min-height: 460px;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-text);
    overflow: hidden;
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow-y: auto;
  }

  .intro {
    padding: 28px clamp(20px, 3.4vw, 44px) 20px;
    flex: none;
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .crumb a {
    color: var(--color-neutral-700);
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--color-accent);
  }

  .slash {
    color: var(--color-neutral-500);
  }

  .index {
    color: var(--color-accent);
  }

  .pulse {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--color-accent);
    animation: bc-pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-size: clamp(24px, 2.4vw, 34px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
    max-width: 24ch;
  }

  .lede {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-neutral-800);
    max-width: 68ch;
    margin: 0;
  }

  .pub-list {
    list-style: none;
    margin: 0;
    padding: 0 clamp(20px, 3.4vw, 44px) 56px;
    display: grid;
    grid-template-columns: 5.5ch 1fr;
    gap: 0 clamp(14px, 1.6vw, 28px);
    border-top: 2px solid var(--color-divider);
  }

  .pub {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding: 22px 0 20px;
    border-bottom: 1px solid var(--color-neutral-300);
  }

  .pub:last-child {
    border-bottom: 0;
  }

  .pub-year {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--color-neutral-600);
  }

  .pub-body {
    min-width: 0;
  }

  .pub-citation {
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
    max-width: 92ch;
    text-wrap: pretty;
  }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 8px;
  }

  .tag.preprint {
    border: 1px solid var(--color-neutral-400);
    color: var(--color-neutral-700);
  }

  .tag.venue {
    background: var(--color-accent-100);
    color: var(--color-accent-700);
  }

  .pub-meta a {
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--color-neutral-700);
    text-decoration: none;
    border-bottom: 1px solid var(--color-neutral-400);
  }

  .pub-meta a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* A long list reads better flowing with the document than trapped in a
     locked viewport — the same trade the index pages make at this width. */
  @media (max-width: 720px) {
    .shell {
      height: auto;
      min-height: 100svh;
      overflow: visible;
    }
    .body {
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
