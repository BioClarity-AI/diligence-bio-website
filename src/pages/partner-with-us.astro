---
import PageShell from '../layouts/PageShell.astro';

const title = 'Partner with us — DiligenceBio';
const description =
  'We partner with radiopharmaceutical and oncology teams case by case. Tell us who you are and the program you are working on, and we will get back to you.';

const mailto = 'mailto:info@diligencebio.ai?subject=Partnership';
---

<PageShell title={title} description={description}>
  <Fragment slot="copy">
    <p class="eyebrow">
      <span class="pulse" aria-hidden="true"></span>
      Partner with us
    </p>

    <h1>Bring Us Your Radioconjugate Program</h1>

    <div class="lede">
      <p>
        We partner with radiopharmaceutical and oncology teams case by case. Email us with who
        you are and the program you are working on—target, isotope, or the stage where it is
        stuck—and we will get back to you.
      </p>
      <p><a href={mailto}>info@diligencebio.ai</a></p>
    </div>

    <div class="actions">
      <a class="btn btn-primary" href={mailto}>Email us →</a>
    </div>
  </Fragment>

  <Fragment slot="stage">
    <canvas data-canvas aria-hidden="true"></canvas>
  </Fragment>
</PageShell>

<script>
  import { initRequestAccess } from '../scripts/requestAccess';
  import { loadSettings } from '../scripts/settings';

  const stage = document.querySelector<HTMLElement>('[data-page-stage]');
  if (stage) {
    const panel = initRequestAccess(stage);
    loadSettings().then(({ requestAccess }) => {
      if (requestAccess) panel.update(requestAccess);
    });
  }
</script>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }

  .pulse {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--color-accent);
    animation: bc-pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-size: clamp(34px, 3.6vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 22px;
    max-width: 15ch;
  }

  .lede {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-neutral-800);
    max-width: 46ch;
    margin: 0 0 32px;
  }

  .lede p {
    margin: 0 0 14px;
  }

  .lede p:last-child {
    margin: 0;
  }

  .actions {
    display: flex;
    gap: 12px;
  }

  .actions .btn {
    padding: 14px 20px;
    font-size: 15px;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
