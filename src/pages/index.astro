---
import PageShell from '../layouts/PageShell.astro';
import Emergence from '../components/Emergence.astro';

const title = 'DiligenceBio — turn AI adoption into scientific value';
const description =
  'DiligenceBio gives pharma and biotech leaders a vendor-agnostic way to identify where AI can create real impact, validate it against their own data and workflows, and tailor proven capabilities to their portfolio.';
---

<PageShell title={title} description={description}>
  <Fragment slot="copy">
    <p class="eyebrow">
      <span class="pulse" aria-hidden="true"></span>
      Trust Layer for Agentic Science
    </p>

    <h1>Turn AI Adoption Into Scientific Value</h1>

    <p class="lede">
      AI is moving faster than most R&D organizations can confidently adopt it. DiligenceBio
      gives pharma and biotech leaders a vendor-agnostic way to identify where AI can create
      real impact, validate it against their own data and workflows, and tailor proven
      capabilities to their portfolio—so AI investment is grounded in evidence, not hype.
    </p>
  </Fragment>

  <Fragment slot="stage">
    <Emergence />
  </Fragment>
</PageShell>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }

  .pulse {
    width: 8px;
    height: 8px;
    flex: none;
    background: var(--color-accent);
    animation: bc-pulse 2.4s ease-in-out infinite;
  }

  h1 {
    font-size: clamp(34px, 3.6vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 22px;
    max-width: 15ch;
  }

  .lede {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-neutral-800);
    max-width: 46ch;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
</style>
