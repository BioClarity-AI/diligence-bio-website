---
/**
 * The canvas and overlay for a page whose stage cycles through scenes.
 *
 * Decorative by design: the canvas is aria-hidden and every claim it draws is
 * also written in the copy beside it. The controls are real buttons so the
 * scenes can be stepped through from the keyboard.
 */
export interface Props {
  /** Small caps line above the readout. */
  kicker: string;
  /** Label of the first scene — replaced by the panel once it starts. */
  initial: string;
  /** What the arrows step through, for the button labels. */
  noun: string;
}

const { kicker, initial, noun } = Astro.props;
---

<canvas data-canvas aria-hidden="true"></canvas>

<div class="overlay" data-overlay>
  <p class="kicker">{kicker}</p>
  <p class="readout" data-readout aria-live="off">{initial}</p>

  <div class="controls">
    <button type="button" data-prev title={`Previous ${noun}`} aria-label={`Previous ${noun}`}>←</button>
    <button type="button" data-next title={`Next ${noun}`} aria-label={`Next ${noun}`}>→</button>
    <span class="sep" aria-hidden="true"></span>
    <button type="button" data-lock class="lock" title="Hold this scene" aria-pressed="false">
      <span class="lock-dot" data-lock-dot aria-hidden="true"></span>
      <span data-lock-label>Auto</span>
    </button>

    {/* Filled by the panel while a scene that has competing builds is on screen. */}
    <span class="sep" data-variant-sep aria-hidden="true" hidden></span>
    <span class="variants" data-variants role="group" aria-label="Scene concept" hidden></span>
  </div>
</div>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .overlay {
    position: absolute;
    top: clamp(16px, 2.4vw, 28px);
    left: clamp(16px, 2.6vw, 32px);
    right: clamp(16px, 2.6vw, 32px);
    pointer-events: none;
  }

  .kicker {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }

  .readout {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(19px, 2.6vw, 30px);
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 6px 0 0;
    color: var(--color-accent);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    pointer-events: auto;
    color: var(--color-neutral-600);
  }

  .controls button {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1;
    color: inherit;
  }

  .controls button:hover {
    color: var(--color-accent);
  }

  .sep {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }

  .lock {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading) !important;
    font-weight: 800;
    font-size: 10px !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lock-dot {
    width: 5px;
    height: 5px;
    background: transparent;
    border: 1px solid currentColor;
  }

  /* The concept picker. Its contents are built by scenePanel.ts once it knows
     how many builds the scene offers, so the children are addressed globally —
     Astro's scoping only reaches elements that were in this template. */
  .variants {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .variants[hidden],
  .sep[hidden] {
    display: none;
  }

  .variants :global(.variant-picks) {
    display: flex;
    gap: 4px;
  }

  .variants :global(button) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    padding: 0;
    background: transparent;
    color: var(--color-neutral-700);
    border: 1px solid var(--color-divider);
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 10px;
    line-height: 1;
  }

  .variants :global(button:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .variants :global(button[aria-pressed='true']) {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-neutral-100);
  }

  .variants :global(.variant-name) {
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }

  /* On a phone held sideways the panel is barely 300px tall, and the drawing
     box has a floor it will not go below — so an overlay at full size ends up
     printed over the scene. Shed the kicker and shrink the readout instead:
     the scene keeps its room and nothing overlaps. */
  @media (orientation: landscape) and (max-height: 520px) {
    .overlay {
      top: 10px;
      left: 14px;
      right: 14px;
    }

    .kicker {
      display: none;
    }

    .readout {
      font-size: 16px;
    }

    .controls {
      margin-top: 6px;
    }
  }
</style>
